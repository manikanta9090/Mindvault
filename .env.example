# Copy this file to .env at the repository root and adjust as needed.
# Never commit the real .env file.

MINDVAULT_APPLICATION=MindVault
MINDVAULT_VERSION=1.0.0
MINDVAULT_ENVIRONMENT=development
MINDVAULT_LOG_LEVEL=INFO
MINDVAULT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MINDVAULT_DOCS_ENABLED=true
MINDVAULT_DATABASE_URL=sqlite:///./storage/mindvault.db

# URL fetching limits used by URL ingestion.
MINDVAULT_FETCH_TIMEOUT_SECONDS=10
MINDVAULT_FETCH_MAX_BYTES=2000000
MINDVAULT_FETCH_MAX_REDIRECTS=3

# Phase 4.1 — text chunking. Size is the total token budget INCLUDING special
# tokens; 256 matches all-MiniLM-L6-v2's max_seq_length. The model tokenizer
# enforces this limit at runtime.
MINDVAULT_CHUNK_SIZE_TOKENS=256
MINDVAULT_CHUNK_OVERLAP_TOKENS=60

# Phase 4.2 — persistent ChromaDB storage and semantic retrieval. Relative
# paths are resolved from the repository root, like MINDVAULT_DATABASE_URL.
MINDVAULT_CHROMA_PATH=./storage/chroma
MINDVAULT_CHROMA_COLLECTION=mindvault_chunks
MINDVAULT_RETRIEVAL_TOP_K=8

# Phase 4.3 — Groq-compatible question answering. The API key is optional at
# startup and is required only by POST /query. Never commit a real key here;
# set MINDVAULT_GROQ_API_KEY in the environment or a local .env file.
MINDVAULT_LLM_PROVIDER=groq
MINDVAULT_GROQ_API_KEY=
MINDVAULT_LLM_MODEL=openai/gpt-oss-20b
MINDVAULT_LLM_TIMEOUT=30
MINDVAULT_LLM_CONTEXT_MAX_CHARS=12000

# Frontend: copy this value into frontend/.env (Vite reads env from its own root).
VITE_API_BASE_URL=http://localhost:8000
